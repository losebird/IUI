// C7: regenerate src/shared/vendor-integrity.ts — sha384 SRI of every registry
// file the public CDNs serve (identical bytes to the installed npm package).
// Run: npx tsx scripts/vendor-integrity.mts   (tests fail on drift)
import { createHash } from 'node:crypto'
import { existsSync, readFileSync, writeFileSync } from 'node:fs'
import { createRequire } from 'node:module'
import { dirname, join } from 'node:path'
import { fileURLToPath } from 'node:url'
import { vendorIntegrityFiles } from '../src/shared/vendor-registry.ts'

const root = join(dirname(fileURLToPath(import.meta.url)), '..')
const require = createRequire(join(root, 'package.json'))

export function computeVendorIntegrity(): Record<string, string> {
  const out: Record<string, string> = {}
  for (const { pkg, version, path } of vendorIntegrityFiles()) {
    const dir = require.resolve.paths(pkg)!.map((d) => join(d, pkg)).find((d) => existsSync(join(d, 'package.json')))
    if (!dir) throw new Error(`vendor ${pkg}: not installed`)
    const installed = JSON.parse(readFileSync(join(dir, 'package.json'), 'utf8')).version
    if (installed !== version) throw new Error(`vendor ${pkg}: registry pins ${version} but ${installed} is installed`)
    out[`${pkg}@${version}/${path}`] = 'sha384-' + createHash('sha384').update(readFileSync(join(dir, path))).digest('base64')
  }
  return out
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  const map = computeVendorIntegrity()
  const body = Object.entries(map).map(([k, v]) => `  '${k}': '${v}',`).join('\n')
  writeFileSync(join(root, 'src/shared/vendor-integrity.ts'), `/**
 * C7: sha384 SRI of the registry files public CDNs serve (jsDelivr / unpkg /
 * npmmirror all return the npm package bytes). GENERATED by
 * scripts/vendor-integrity.mts — do not edit; tests fail when it drifts from
 * node_modules (bump a version → re-run the script).
 */
export const VENDOR_INTEGRITY: Readonly<Record<string, string>> = {
${body}
}
`)
  console.log(`vendor-integrity: ${Object.keys(map).length} files`)
}
