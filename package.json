    "version:print": "node -p \"require(\\\"./package.json\\\").version\"",
    "smoke:fence-empty": "tsx scripts/smoke-fence-empty.mts",
    "e2e:session": "tsx scripts/e2e-session.mts",
    "shots:sandbox-hd": "tsx scripts/render-sandbox-hd-shots.mts"
  },
