    "check:host-api": "node scripts/check-host-api.mjs",
    "prepack": "node scripts/prepack.mjs",
    "smoke:fence": "vitest run tests/format-referee.spec.ts tests/html-sandbox.spec.ts tests/composer-bridge.spec.ts tests/user-templates.spec.ts tests/status-block.spec.ts tests/skill-md.spec.ts tests/binding-parse.spec.ts tests/genui-shape-json.spec.ts tests/appdata-runtime.spec.ts tests/progressive-mount.spec.ts tests/fence-ops.spec.ts tests/format-router.spec.ts tests/structured-outputs.spec.ts tests/map-embed.spec.ts",
